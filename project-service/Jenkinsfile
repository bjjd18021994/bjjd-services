pipeline {
  agent any
  environment {
    REPO_URL = "https://github.com/bjjd18021994/helm-charts.git"
    GITHUB_CREDENTIALS = credentials('github-credentials-id')
    CHART_DIR = "helm/project-service"
    BRANCH = "gh-pages"
  }
  tools {
    maven 'M3'
  }
  stages {
    stage('Checkout from Git Repository') {
      steps {
        git url: 'https://github.com/bjjd18021994/bjjd-services.git', branch: 'master'
      }
    }
    stage('Build Project') {
      steps {
        dir('project-service') {
            withCredentials([usernamePassword(
              credentialsId: 'dockerhub-creds',
              usernameVariable: 'DOCKER_USERNAME',
              passwordVariable: 'DOCKER_PASSWORD'
            )]) {
                echo "Building the project and push the Docker image for Project Service..."
                sh "mvn clean install -DskipTests -Pkubernetes"
            }
          }
      }
    }
  }
}