pipeline {
  agent any
  environment {
    REPO_URL = "https://github.com/bjjd18021994/helm-charts.git"
    GITHUB_CREDENTIALS = credentials('github-credentials-id')
    CHART_DIR = "helm/project-service"
    BRANCH = "gh-pages
  }
  tools {
    maven 'M3'
  }
  stages {
    stage('Checkout from Git Repository') {
      steps {
        git url: 'https://github.com/bjjd18021994/bjjd-services.git', branch: 'master'
      }
    }
    stage('Build Project') {
      steps {
        dir('project-service') {
            sh "mvn clean install -DskipTests -Pkubernetes"
            script {
              def version = sh script: 'mvn help:evaluate -Dexpression=project.version -q -DforceStdout', returnStdout: true
              print version
              env.version = version
            }
          }
      }
    }
    stage('Package helm chart and Push to Nexus Repository') {
          steps {
            script{
                    dir('project-service/k8s') {
                        def chartVersion =  sh script: "helm show chart project-service | grep version | cut -d: -f 2 | tr -d ' ' | tr -d '\\n'",returnStdout: true
                        def chartName =  sh script: "helm show chart project-service | grep name | cut -d: -f 2 | tr -d ' ' | tr -d '\\n'",returnStdout: true
                        def chartPackage ="${chartName}-${chartVersion}.tgz"
                        def chartPath = "helm/project-service"

                        echo "Packaging helm chart"
                        sh "helm package ${chartPath} --version ${chartVersion}"

                        //2. Pushing helm chart in nexus repository
                  }
            }
          }
        }
  }
  stage('Publish to GitHub Pages (Safe + Cleanup)') {
      steps {
          withCredentials([usernamePassword(
              credentialsId: 'github-credentials-id',
              usernameVariable: 'GIT_USER',
              passwordVariable: 'GIT_TOKEN'
          )]) {

              sh """
              rm -rf repo
              git clone https://${GIT_USER}:${GIT_TOKEN}@github.com/bjjd18021994/helm-charts.git repo

              cd repo
              git checkout ${BRANCH} || git checkout -b ${BRANCH}

              cp ../packaged/*.tgz .

              # Cleanup: keep last 5 versions per chart
              for chart in \$(ls *.tgz | sed 's/-[0-9].*//' | sort -u); do
                ls -t \${chart}-*.tgz | tail -n +6 | xargs -r rm -f
              done

              # Merge index safely
              if [ -f index.yaml ]; then
                helm repo index . --url ${HELM_REPO_URL} --merge index.yaml
              else
                helm repo index . --url ${HELM_REPO_URL}
              fi

              git add .
              git commit -m "Update Helm repo with cleanup" || echo "No changes"
              git push origin ${BRANCH}
              """
          }
      }
  }
  stage('Deploy helm chart in Kubernetes Environment') {
                            steps {
                              script{
                                      dir('project-service/k8s') {
                                          //Deploying helm chart on Kubernetes environment
                                          sh "helm upgrade --install -n bjjd-system --create-namespace project-service project-service"
                                  }
                              }
                            }
          }
          stage('Health Check') {
            steps {
              script {
                sh """
                kubectl rollout status deployment/project-service -n bjjd-system --timeout=120s
                """
              }
            }
          }

}