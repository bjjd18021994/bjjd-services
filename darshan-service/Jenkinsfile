pipeline {
  agent any
  environment {
    GITHUB_CREDENTIALS = credentials('github-credentials-id')
    BRANCH = "gh-pages"
  }
  tools {
    maven 'M3'
  }
  stages {
    stage('Checkout from Git Repository') {
      steps {
        git url: 'https://github.com/bjjd18021994/bjjd-services.git', branch: 'master'
      }
    }
    stage('Build Project') {
      steps {
            withCredentials([usernamePassword(
              credentialsId: 'dockerhub-creds',
              usernameVariable: 'DOCKER_USERNAME',
              passwordVariable: 'DOCKER_PASSWORD'
            )]) {
                echo "Building the project and push the Docker image for Darshan Service..."
                sh "mvn clean install -pl darshan-service -am -DskipTests -Pkubernetes"
            }
      }
    }
  }
}